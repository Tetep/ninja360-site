---
// /restaurants — our 54th Street Grill & Bar case study, rebuilt on the card pattern from the
// "Locations Page Experiment for 54th Street / Five Four" design (Tim, 11/2026).
// Every location card plays its own 360° moving clip and taps through to the full Kuula tour.
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { BUSINESS } from '../consts.ts';
import { LOCS, REGIONS, SITE, ORDER_URL, FLYOVER, HOURS, tourUrl, ytWatch, ytThumb } from '../data/fiftyfourth.ts';

const FILMS = LOCS.filter(l => l.film);
const tours = LOCS.filter(l => l.kuula).length;
const tel = (p: string) => 'tel:+1' + p.replace(/\D/g, '');
const maps = (l: (typeof LOCS)[number]) =>
  'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('54th Street ' + l.addr + ' ' + l.city);
const hay = (l: (typeof LOCS)[number]) => [l.name, l.sub, l.addr, l.city].join(' ').toLowerCase();
const groups = REGIONS.map(r => ({ ...r, items: LOCS.filter(l => l.region === r.id) }));
const title = (l: (typeof LOCS)[number]) => l.sub ? `${l.name} · ${l.sub}` : l.name;
---
<Base
  title="54th Street Grill & Bar: 32 Locations in 360°"
  description="Ninja 360 Digital Media shot all 32 54th Street Grill & Bar locations across four states: 28 360° virtual tours and 4 drone films. Step inside any of them."
  path="/restaurants">
  <style is:global>
    .fs{--ink:#F5F3EF;--mute:#B3AFA8;--line:#34363D;--card:#24262C;--bg:#1B1C20;background:var(--bg);color:var(--ink)}
    .fs a{color:inherit;text-decoration:none}
    .fs .wrap{max-width:1240px;margin:0 auto;padding:0 20px}
    .fs .kick{font-size:13px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--orange)}
    .fs h2{font-family:var(--font-head);font-size:clamp(30px,4vw,44px);line-height:1.1;margin:6px 0 0}
    .fs .btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:0 22px;border-radius:8px;font-weight:600}
    .fs .btn-o{background:var(--orange);color:#fff}
    .fs .btn-g{border:1px solid rgba(255,255,255,.4);color:#fff;background:rgba(255,255,255,.06)}
    .fs .btn:focus-visible,.fs a:focus-visible,.fs button:focus-visible,.fs input:focus-visible{outline:3px solid var(--orange);outline-offset:2px}
    /* top bar */
    .fs-top{position:sticky;top:0;z-index:30;background:rgba(27,28,32,.94);border-bottom:1px solid var(--line)}
    .fs-top .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:64px}
    .fs-brand{font-family:var(--font-display);font-size:20px;letter-spacing:.02em}
    .fs-brand span{color:var(--orange)}
    /* hero */
    .fs-hero{position:relative;min-height:min(86vh,720px);display:flex;align-items:flex-end;overflow:hidden;background:#000}
    .fs-hero .poster{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
    .fs-hero .vid{position:absolute;top:50%;left:50%;width:max(100%,177.78vh);height:max(100%,56.25vw);transform:translate(-50%,-50%) scale(1.25);border:0;pointer-events:none}   /* 25% over-scan hides YouTube's title bar and caption strip */
    .fs-hero .shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.25),rgba(0,0,0,.72))}
    .fs-hero .wrap{position:relative;padding-top:120px;padding-bottom:56px;width:100%}
    .fs-hero h1{font-family:var(--font-head);font-size:clamp(44px,8vw,88px);line-height:1;margin:0;color:#fff;max-width:900px}
    .fs-hero p{font-size:clamp(17px,2vw,20px);color:#E8E5DF;max-width:640px;margin:18px 0 0}
    .fs-hero .ctas{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}
    .fs-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:12px;overflow:hidden;margin-top:36px;max-width:820px}
    .fs-stats div{background:rgba(20,21,24,.82);padding:14px 16px}
    .fs-stats b{display:block;font-size:26px;font-family:var(--font-head);color:#fff}
    .fs-stats span{font-size:13px;color:var(--mute)}
    @media (prefers-reduced-motion:reduce){.fs-hero .vid{display:none}}
    /* films */
    .fs-films{padding:72px 0 16px}
    .fs-films .row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px;margin-top:26px}
    .fs-film .m{position:relative;aspect-ratio:16/9;border-radius:10px;overflow:hidden;border:1px solid var(--line);background:#000}
    .fs-film img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s}
    .fs-film:hover img{transform:scale(1.04)}
    .fs-film .play{position:absolute;left:12px;bottom:12px;width:44px;height:44px;border-radius:50%;background:var(--orange);display:flex;align-items:center;justify-content:center}
    .fs-film .tag{position:absolute;right:10px;top:10px;background:rgba(0,0,0,.72);font-size:11px;font-weight:700;letter-spacing:.08em;padding:4px 8px;border-radius:4px}
    .fs-film .t{margin-top:10px;font-weight:700}.fs-film .s{font-size:14px;color:var(--mute)}
    /* finder */
    .fs-find{padding:64px 0 8px}
    .fs-search{display:flex;align-items:center;gap:10px;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:0 16px;min-height:52px;max-width:560px;margin-top:22px}
    .fs-search input{flex:1;background:transparent;border:0;outline:none;color:var(--ink);font:inherit;font-size:16px;min-height:48px}
    .fs-search input::placeholder{color:#8E8B86}
    .fs-tabs{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
    .fs-tabs button{min-height:44px;padding:0 18px;border-radius:999px;font:inherit;font-size:14px;font-weight:600;cursor:pointer;background:var(--card);color:#E4E1DB;border:1px solid #44474F}
    .fs-tabs button[aria-pressed="true"]{background:var(--ink);color:#1B1C20;border-color:var(--ink)}
    .fs-tabs .n{opacity:.65;font-weight:500;margin-left:4px}
    .fs-sum{font-size:14px;color:var(--mute);margin:14px 0 0}
    /* groups + cards */
    .fs-groups{padding:24px 0 72px;display:flex;flex-direction:column;gap:52px}
    .fs-gh{display:flex;align-items:baseline;gap:14px;border-bottom:1px solid var(--line);padding-bottom:10px;margin-bottom:20px}
    .fs-gh h3{margin:0;font-size:26px}.fs-gh span{color:var(--mute);font-size:14px}
    .fs-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px}
    .fs-card{background:var(--card);border:1px solid var(--line);border-radius:12px;overflow:hidden;display:flex;flex-direction:column}
    .fs-media{position:relative;display:block;aspect-ratio:16/9;background:#000;overflow:hidden}
    .fs-media video,.fs-media img{width:100%;height:100%;object-fit:cover;display:block}
    .fs-pill{position:absolute;left:12px;bottom:12px;display:inline-flex;align-items:center;gap:8px;background:rgba(14,15,18,.84);border:1px solid rgba(255,106,0,.7);color:#fff;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:6px 10px;border-radius:999px}
    .fs-pill.film{background:var(--orange);border-color:var(--orange)}
    .fs-body{padding:16px 18px 18px;display:flex;flex-direction:column;gap:10px;flex:1}
    .fs-body h4{margin:0;font-size:18px;line-height:1.25;font-family:var(--font-body)}
    .fs-body .sub{font-size:13px;color:var(--mute)}
    .fs-body .addr{font-size:14px;color:#DAD6D0}
    .fs-body .meta{display:flex;gap:12px;flex-wrap:wrap;font-size:14px}
    .fs-body .meta a{font-weight:600}.fs-body .meta span{color:var(--mute)}
    .fs-acts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:auto;padding-top:6px}
    .fs-acts a{display:flex;align-items:center;justify-content:center;min-height:44px;border:1px solid #4A4D55;border-radius:8px;font-weight:600;font-size:14px;text-align:center}
    .fs-acts a.p{grid-column:1/-1;background:var(--orange);border-color:var(--orange);color:#fff}
    .fs-more{font-size:14px;font-weight:600;color:var(--orange) !important}
    .fs-empty{text-align:center;padding:40px 16px;color:var(--mute)}
    .fs-empty button{background:none;border:0;color:var(--orange);font:inherit;font-weight:600;cursor:pointer;min-height:44px}
    /* closing */
    .fs-close{background:var(--orange);color:#fff}
    .fs-close .wrap{padding-top:48px;padding-bottom:48px;display:flex;gap:28px;align-items:center;justify-content:space-between;flex-wrap:wrap}
    .fs-close h2{color:#fff}.fs-close p{margin:8px 0 0;max-width:640px;color:#FFF1E6}
    .fs-close .btn{background:#1B1C20;color:#fff}
    .fs-credit{text-align:center;font-size:13px;color:var(--mute);padding:22px 20px;border-top:1px solid var(--line)}
    .fs-credit a{color:#E4E1DB;font-weight:600}
    @media (max-width:900px){.fs-films .row{grid-template-columns:repeat(2,minmax(0,1fr))}.fs-stats{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media (max-width:520px){.fs-films .row{grid-template-columns:1fr}}
    [hidden]{display:none !important}
  </style>

  <div class="fs">
    <header class="fs-top">
      <div class="wrap">
        <a href="/" class="fs-brand" aria-label={`${BUSINESS.name} home`}>NINJA <span>360</span></a>
        <a href="/free-audit" class="btn btn-o">Free visibility audit</a>
      </div>
    </header>

    <main>
      <section class="fs-hero" aria-labelledby="fs-h1">
        <img class="poster" src="/media/54th-street/lees-summit-mo.jpg" alt="" aria-hidden="true" />
        <iframe class="vid" aria-hidden="true" tabindex="-1" title="54th Street flyover (background)"
          src={`https://www.youtube-nocookie.com/embed/${FLYOVER}?autoplay=1&mute=1&loop=1&playlist=${FLYOVER}&controls=0&playsinline=1&rel=0&modestbranding=1&disablekb=1&cc_load_policy=0&iv_load_policy=3&fs=0`}
          allow="autoplay; encrypted-media" loading="eager"></iframe>
        <div class="shade" aria-hidden="true"></div>
        <div class="wrap">
          <div class="kick">Case study · 54th Street Grill &amp; Bar</div>
          <h1 id="fs-h1">Grab a seat.<br />Take a step inside.</h1>
          <p>Every 54th Street location, from the air and from the bar stool. We shot all 32 restaurants across four states, so a hungry guest can walk the dining room before they ever leave the house.</p>
          <div class="ctas">
            <a class="btn btn-o" href={ytWatch(FLYOVER)} target="_blank" rel="noopener">
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15l13-7.5z"/></svg>Watch the flyover
            </a>
            <a class="btn btn-g" href="#find">Step inside a location</a>
          </div>
          <div class="fs-stats">
            <div><b>{LOCS.length}</b><span>locations, 4 states</span></div>
            <div><b>{tours}</b><span>360° virtual tours</span></div>
            <div><b>{FILMS.length}</b><span>drone &amp; FPV films</span></div>
            <div><b>5.5M+</b><span>cumulative Google views</span></div>
          </div>
        </div>
      </section>

      <section class="fs-films" aria-labelledby="fs-films-h">
        <div class="wrap">
          <div class="kick">From above</div>
          <h2 id="fs-films-h">See it before you get there</h2>
          <div class="row">
            {FILMS.map(l => (
              <a class="fs-film" href={ytWatch(l.film)} target="_blank" rel="noopener">
                <div class="m">
                  <img src={ytThumb(l.film)} alt={`${l.filmKind === 'FPV' ? 'FPV flight' : 'Aerial view'} of 54th Street ${title(l)}`} loading="lazy" width="480" height="360" />
                  <span class="play" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="#fff"><path d="M7 4.5v15l13-7.5z"/></svg></span>
                  <span class="tag">{l.filmKind}</span>
                </div>
                <div class="t">{title(l)}</div>
                <div class="s">{l.filmNote}</div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="fs-find" id="find" aria-labelledby="fs-find-h">
        <div class="wrap">
          <div class="kick">Step inside</div>
          <h2 id="fs-find-h">Find a 54th Street</h2>
          <label class="fs-search" for="fs-q">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#B3AFA8" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
            <span class="sr" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Search by city, ZIP or neighborhood</span>
            <input id="fs-q" type="search" placeholder="City, ZIP or neighborhood" autocomplete="off" />
          </label>
          <div class="fs-tabs" role="group" aria-label="Filter by metro">
            <button type="button" data-region="all" aria-pressed="true">All metros<span class="n" data-n="all">{LOCS.length}</span></button>
            {groups.map(g => (
              <button type="button" data-region={g.id} aria-pressed="false">{g.name}<span class="n" data-n={g.id}>{g.items.length}</span></button>
            ))}
          </div>
          <p class="fs-sum" id="fs-sum" aria-live="polite">Showing {LOCS.length} of {LOCS.length} locations</p>
        </div>
      </section>

      <section class="fs-groups wrap" aria-label="Locations">
        {groups.map(g => (
          <div class="fs-group" data-group={g.id}>
            <div class="fs-gh"><h3>{g.name}</h3><span data-gcount={g.id}>{g.items.length} locations</span></div>
            <div class="fs-grid">
              {g.items.map(l => (
                <article class="fs-card" data-region={l.region} data-hay={hay(l)}>
                  {l.clip ? (
                    <a class="fs-media" href={tourUrl(l.kuula)} target="_blank" rel="noopener" aria-label={`Take the 360° tour of 54th Street ${title(l)}`}>
                      <video muted loop playsinline preload="none" poster={`/media/54th-street/${l.slug}.jpg`} aria-hidden="true">
                        <source src={`/media/54th-street/${l.slug}.mp4`} type="video/mp4" />
                      </video>
                      <span class="fs-pill"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 48 48" fill="none" stroke="#FF6A00" stroke-width="4" stroke-linecap="round"><ellipse cx="24" cy="24" rx="20" ry="8"/><ellipse cx="24" cy="24" rx="8" ry="20"/></svg>Step inside · 360°</span>
                    </a>
                  ) : (
                    <a class="fs-media" href={ytWatch(l.film)} target="_blank" rel="noopener" aria-label={`Watch the 54th Street ${title(l)} film`}>
                      <img src={ytThumb(l.film)} alt="" loading="lazy" width="480" height="360" />
                      <span class="fs-pill film"><svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15l13-7.5z"/></svg>Watch the film</span>
                    </a>
                  )}
                  <div class="fs-body">
                    <div><h4>{l.name}</h4>{l.sub && <div class="sub">{l.sub}</div>}</div>
                    <div class="addr">{l.addr}<br />{l.city}</div>
                    <div class="meta"><a href={tel(l.phone)}>{l.phone}</a><span>{HOURS}</span></div>
                    <div class="fs-acts">
                      <a class="p" href={`${SITE}${l.slug}.html#join-the-wait`} target="_blank" rel="noopener">Join the Wait</a>
                      <a href={ORDER_URL} target="_blank" rel="noopener">Order</a>
                      <a href={maps(l)} target="_blank" rel="noopener">Directions</a>
                    </div>
                    {!l.clip && l.kuula && <a class="fs-more" href={tourUrl(l.kuula)} target="_blank" rel="noopener">Take the 360° tour →</a>}
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))}
        <div class="fs-empty" id="fs-empty" hidden>No locations match that search. <button type="button" id="fs-reset">Show all locations</button></div>
      </section>

      <section class="fs-close" aria-labelledby="fs-close-h">
        <div class="wrap">
          <div>
            <h2 id="fs-close-h">One location or fifty, we'll put you on the M.A.P.</h2>
            <p>360° tours, drone films and a Google Business Profile that gets you found and chosen. Start with a free visibility audit.</p>
          </div>
          <a class="btn" href="/free-audit">Get my free audit</a>
        </div>
      </section>

      <p class="fs-credit">360° tours &amp; aerial films by <a href="/">{BUSINESS.name}</a>.</p>
    </main>
  </div>
  <SiteFooter />

  <script>
    // Each card's 360° clip plays only while it is on screen (and never under reduced motion).
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const vids = Array.from(document.querySelectorAll<HTMLVideoElement>('.fs-media video'));
    if (!still && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(es => es.forEach(e => {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) { v.play().catch(() => {}); } else { v.pause(); }
      }), { threshold: 0.4 });
      vids.forEach(v => io.observe(v));
    }

    // Finder: free-text search plus a metro filter, counts kept in step.
    const q = document.getElementById('fs-q') as HTMLInputElement;
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.fs-tabs button'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.fs-card'));
    const groupsEl = Array.from(document.querySelectorAll<HTMLElement>('.fs-group'));
    const sum = document.getElementById('fs-sum')!;
    const empty = document.getElementById('fs-empty')!;
    let region = 'all';
    function apply() {
      const t = q.value.trim().toLowerCase();
      const byQ = cards.filter(c => !t || (c.dataset.hay || '').includes(t));
      const counts: Record<string, number> = { all: byQ.length };
      byQ.forEach(c => { const r = c.dataset.region!; counts[r] = (counts[r] || 0) + 1; });
      document.querySelectorAll<HTMLElement>('[data-n]').forEach(n => { n.textContent = String(counts[n.dataset.n!] || 0); });
      let shown = 0;
      cards.forEach(c => { const on = byQ.includes(c) && (region === 'all' || c.dataset.region === region); c.hidden = !on; if (on) shown++; });
      groupsEl.forEach(g => {
        const vis = g.querySelectorAll('.fs-card:not([hidden])').length;
        g.hidden = vis === 0;
        const gc = g.querySelector<HTMLElement>('[data-gcount]'); if (gc) gc.textContent = vis + (vis === 1 ? ' location' : ' locations');
      });
      tabs.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.region === region)));
      empty.hidden = shown !== 0;
      sum.textContent = 'Showing ' + shown + ' of ' + cards.length + ' locations' + (t ? ' matching “' + q.value.trim() + '”' : '');
    }
    q.addEventListener('input', apply);
    tabs.forEach(b => b.addEventListener('click', () => { region = b.dataset.region!; apply(); }));
    document.getElementById('fs-reset')!.addEventListener('click', () => { q.value = ''; region = 'all'; apply(); });
  </script>
</Base>
